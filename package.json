{
  "name": "age-calculator",
  "private": true,
  "version": "1.0.0",
  "description": "Free, simple online tools for everyday calculations.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "node scripts/copy-static-files.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-static-files.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr-build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:print": "node scripts/print-check.mjs",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:seo": "node scripts/seo-audit.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "csso": "5.0.5",
    "docx": "9.13.0",
    "dompurify": "3.4.17",
    "js-beautify": "2.0.3",
    "jsbarcode": "3.12.3",
    "jsqr": "1.4.0",
    "lucide-react": "^1.67.0",
    "mammoth": "1.13.0",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.12",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "spark-md5": "3.0.2",
    "sql-formatter": "15.9.0",
    "terser": "5.51.2",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
