# Copy to .env.local for local builds, or set these in Vercel's project settings.
# These values are public: anything prefixed VITE_ is included in the browser bundle.
# Never put secrets in them.

# Public site URL with no trailing slash, used for canonical, Open Graph and sitemap URLs.
# Optional on Vercel, which falls back to the project's production domain.
VITE_SITE_URL=

# Google AdSense. Ads stay off until the publisher ID and a slot ID are set.
# Publisher ID format: ca-pub-1234567890123456
VITE_ADSENSE_PUBLISHER_ID=
VITE_AD_SLOT_HEADER=
VITE_AD_SLOT_IN_CONTENT=
VITE_AD_SLOT_FOOTER=
